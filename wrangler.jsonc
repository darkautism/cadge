{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["enable_request_signal"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "BROKER", "class_name": "Broker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Broker"] }],
  "vars": {
    "MODEL_ID": "cadge",
    "REQUEST_TIMEOUT_MS": "120000"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cadge.isekai.date", "custom_domain": true }
  ]
}
